# Copy to .env and fill in. Never commit .env.

# Your Anthropic API key (console.anthropic.com > API keys). Required for Generate, Revise, Suggest and Analyze.
ANTHROPIC_API_KEY=

# First admin account, created on the first start only.
ADMIN_EMAIL=you@darman.ai
ADMIN_NAME=Your Name
# Leave empty to have a random password printed in the logs.
ADMIN_PASSWORD=

# Model. Default is Claude Opus 5.
CLAUDE_MODEL=claude-opus-5
# Refusal fallbacks re-run a declined request on another model. Set to off to disable.
CLAUDE_FALLBACKS=on

# Port on the server. 80 while you use the IP address.
HTTP_PORT=80

# Once you serve over HTTPS (DOMAIN below + the https profile), set COOKIE_SECURE=true and TRUST_PROXY=true.
DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY=false

# Optional: lets automations (like the twice-weekly news check) add research. Any long random string.
INGEST_TOKEN=
