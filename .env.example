# Copy to .env and fill in. Never commit .env.

# AI key: set ONE of these. Needed for Generate, Revise, Suggest and Analyze.
#
# OpenAI (platform.openai.com > API keys). Also set OPENAI_MODEL: after the first start run
#   docker compose exec app node manage.js models
# to list the model IDs your key can use, pick your preferred current model, put it here, and restart.
OPENAI_API_KEY=
OPENAI_MODEL=
#
# Or Anthropic / Claude (console.anthropic.com > API keys).
ANTHROPIC_API_KEY=
# If both keys are set, choose: openai or anthropic
AI_PROVIDER=

# First admin account, created on the first start only.
ADMIN_EMAIL=you@darman.ai
ADMIN_NAME=Your Name
# Leave empty to have a random password printed in the logs.
ADMIN_PASSWORD=

# Claude only: model (default Claude Opus 5), and refusal fallbacks that re-run a declined request on another model.
CLAUDE_MODEL=claude-opus-5
CLAUDE_FALLBACKS=on

# Port on the server. 80 while you use the IP address.
HTTP_PORT=80

# Once you serve over HTTPS (DOMAIN below + the https profile), set COOKIE_SECURE=true and TRUST_PROXY=true.
DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY=false

# Optional: lets automations (like the twice-weekly news check) add research. Any long random string.
INGEST_TOKEN=
